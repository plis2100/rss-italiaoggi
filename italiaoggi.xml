name: Actualizar RSS de ItaliaOggi

on:
  workflow_dispatch:

  schedule:
    # Cada hora, de lunes a sábado.
    # El horario español se comprueba más abajo.
    - cron: "5 * * * 1-6"

permissions:
  contents: write

concurrency:
  group: actualizar-rss-italiaoggi
  cancel-in-progress: false

jobs:
  comprobar-horario:
    runs-on: ubuntu-latest

    outputs:
      ejecutar: ${{ steps.horario.outputs.ejecutar }}

    steps:
      - name: Comprobar horario de España
        id: horario
        shell: bash
        run: |
          HORA=$(TZ=Europe/Madrid date +%H)

          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "ejecutar=true" >> "$GITHUB_OUTPUT"
          elif [ "$HORA" -ge 7 ] && [ "$HORA" -le 22 ]; then
            echo "ejecutar=true" >> "$GITHUB_OUTPUT"
          else
            echo "ejecutar=false" >> "$GITHUB_OUTPUT"
          fi

  actualizar:
    needs: comprobar-horario
    if: needs.comprobar-horario.outputs.ejecutar == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Instalar dependencias
        run: python -m pip install -r requirements.txt

      - name: Crear RSS de ItaliaOggi
        run: python italiaoggi.py

      - name: Guardar RSS actualizado
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add italiaoggi.xml
          git diff --cached --quiet || git commit -m "Actualizar RSS de ItaliaOggi"
          git push
